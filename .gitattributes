# Only track Python packer cache with LFS (not served by GitHub Pages)
# docs/data/ is NOT tracked by LFS — GitHub Pages needs to serve real files
*.zip filter=lfs diff=lfs merge=lfs -text
*.chd filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.wbfs filter=lfs diff=lfs merge=lfs -text
